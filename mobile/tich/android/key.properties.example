# Copy to android/key.properties (gitignored) before release builds.
# Generate a upload keystore once (keep backups; Play App Signing uses this as upload key):
#
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Place upload-keystore.jks in this android/ folder (also gitignored via *.jks).

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
