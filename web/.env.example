APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Set to false to skip MFA setup and verification (local/demo only).
MFA_ENABLED=false

# Resolve approximate login location from IP in audit logs (uses ip-api.com).
AUDIT_GEO_LOOKUP_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tich_erp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=tich-erp
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.tich.africa
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_VERIFY_PEER=false

# Shared SMTP host; each mailbox uses its own @tich.africa credentials.
MAIL_HR_ADDRESS=hr@tich.africa
MAIL_HR_PASSWORD=
MAIL_HR_NAME="TICH Human Resources"

MAIL_ACADEMICS_ADDRESS=academics@tich.africa
MAIL_ACADEMICS_PASSWORD=
MAIL_ACADEMICS_NAME="TICH Academics"

MAIL_FINANCE_ADDRESS=finance@tich.africa
MAIL_FINANCE_PASSWORD=
MAIL_FINANCE_NAME="TICH Finance"

MAIL_OTP_ADDRESS=otp@tich.africa
MAIL_OTP_PASSWORD=
MAIL_OTP_NAME="TICH Security"

MAIL_NOTIFICATION_ADDRESS=notification@tich.africa
MAIL_NOTIFICATION_PASSWORD=
MAIL_NOTIFICATION_NAME="TICH Notifications"

# Default/fallback sender
MAIL_USERNAME=notification@tich.africa
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notification@tich.africa
MAIL_FROM_NAME="TICH ERP"



AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
