APP_NAME="TICH in Africa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Production: APP_ENV=production and APP_DEBUG=false (never expose stack traces).
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tich.africa

# Optional CDN / alternate asset host for css, js, images (defaults to APP_URL).
# ASSET_URL=https://tich.africa

# Force generated route/asset URLs to use APP_URL (auto-on in production).
# FORCE_APP_URL=true

# Set to false to skip MFA setup and verification (local/demo only).
MFA_ENABLED=false

# Auth throttles (attempts per minute)
AUTH_LOGIN_THROTTLE=5
AUTH_OTP_THROTTLE=3
AUTH_PASSWORD_RESET_THROTTLE=3

# Password policy
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_MIXED_CASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# Trusted reverse proxies (comma-separated IPs/CIDRs, or * behind a known proxy).
# Leave empty for direct connections (php artisan serve / local XAMPP without a proxy).
TRUSTED_PROXIES=

# Admin/ICT IP allowlist (off by default for local). Enable in production.
ADMIN_IP_ALLOWLIST_ENABLED=false
ADMIN_IP_ALLOWLIST=127.0.0.1,::1

# Optional: set when bootstrapping Super Admin accounts via EnsureSuperAdminSeeder
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_PASSWORD_ALT=
# SUPER_ADMIN_FORCE_PASSWORD_RESET=false

# Resolve approximate login location from IP in audit logs (uses ip-api.com).
AUDIT_GEO_LOOKUP_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tich_erp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

# Platform security (see config/security.php)
FORCE_HTTPS=false
SECURITY_HEADERS=true
SECURITY_SANITIZE_INPUT=true
SECURITY_BLOCK_INSPECT_UI=false
# Behind Apache/cPanel/Cloudflare set TRUSTED_PROXIES=* (or specific proxy IPs) so HTTPS detection works.
# TRUSTED_PROXIES=*

# Broadcasting - use null on production unless Reverb/Pusher is actually running.
# Local Reverb defaults below will break saves on production if left enabled.
BROADCAST_CONNECTION=null

# Local websocket (only when BROADCAST_CONNECTION=reverb and `php artisan reverb:start` is running)
REVERB_APP_ID=tich-erp
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.tich.africa
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_VERIFY_PEER=false
# Fail unreachable SMTP quickly instead of hanging HTTP requests (seconds).
# Invite emails often need 10–20s on mail.tich.africa — keep this >= 20.
MAIL_TIMEOUT=30
# Optional override for SMTP EHLO hostname (defaults from MAIL_HOST, not APP_URL)
# MAIL_EHLO_DOMAIN=tich.africa
# Public HTTPS host for links inside emails (required when APP_URL is local/private).
# MAIL_LINK_URL=https://tich.africa
MAIL_LINK_URL=http://127.0.0.1:8000

# Shared SMTP host; each mailbox uses its own @tich.africa credentials.
MAIL_HR_ADDRESS=hr@tich.africa
MAIL_HR_PASSWORD=
MAIL_HR_NAME="TICH Human Resources"

MAIL_ACADEMICS_ADDRESS=academics@tich.africa
MAIL_ACADEMICS_PASSWORD=
MAIL_ACADEMICS_NAME="TICH Academics"

MAIL_FINANCE_ADDRESS=finance@tich.africa
MAIL_FINANCE_PASSWORD=
MAIL_FINANCE_NAME="TICH Finance"

MAIL_OTP_ADDRESS=otp@tich.africa
MAIL_OTP_PASSWORD=
MAIL_OTP_NAME="TICH Security"

MAIL_NOTIFICATION_ADDRESS=notification@tich.africa
MAIL_NOTIFICATION_PASSWORD=
MAIL_NOTIFICATION_NAME="TICH Notifications"

MAIL_ICT_ADDRESS=ict@tich.africa
MAIL_ICT_PASSWORD=
MAIL_ICT_NAME="TICH Information & Communication Technology"

# Default/fallback sender
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notification@tich.africa
MAIL_FROM_NAME="TICH ERP"

# M-Pesa Daraja (optional - finance staff can also configure live in Finance → M-Pesa settings)
MPESA_ENABLED=false
MPESA_ALLOW_LOCAL_SIMULATE=false
MPESA_ENVIRONMENT=sandbox
MPESA_SHORTCODE=
# Copy credentials from Daraja portal → your app → Test Credentials (never commit real secrets)
MPESA_PASSKEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Optional shared secret: append ?token=... to callback URL or send X-Mpesa-Callback-Token header
MPESA_CALLBACK_SECRET=
# Public URL Safaricom can reach (required for STK push + payment confirmation).
# Production example: https://tich.africa/tich-mpesa-stk-callback.php?token=YOUR_SECRET
MPESA_CALLBACK_URL=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_ACCOUNT_REFERENCE_PREFIX=TICH

# QuickBooks (Administration ledger sync)
QUICKBOOKS_ENABLED=false
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=

# Employee clock-in GPS (HR attendance)
HR_ATTENDANCE_REQUIRE_LOCATION=true
HR_ATTENDANCE_CAMPUS_NAME="Main Campus, Kisumu"
HR_ATTENDANCE_CAMPUS_LAT=-0.091702
HR_ATTENDANCE_CAMPUS_LNG=34.767956
HR_ATTENDANCE_CAMPUS_RADIUS_M=500
HR_ATTENDANCE_MAX_ACCURACY_M=2000



AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
